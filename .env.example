# BellDeviceMonitor - Docker configuration.
# Copy this file to `.env` (gitignored) and fill in your values.
# These BCDM_* variables are injected into the container by docker-compose.
# Keep comments on their own lines: env_file does NOT strip an inline
# "# comment" after a value, it becomes part of the value.

# --- Router (Bell / Sagemcom F@st gateway) ---
BCDM_ROUTER_HOST=192.168.2.1
BCDM_ROUTER_USER=admin
# REQUIRED: your router admin password
BCDM_ROUTER_PASSWORD=
# encryption: SHA512 (Home Hub) or MD5
BCDM_ENCRYPTION=SHA512
BCDM_VERIFY_SSL=true

# --- Poller ---
BCDM_POLL_INTERVAL_SECONDS=30
BCDM_RETENTION_DAYS=1024

# --- Dashboard login (HTTP Basic) - CHANGE THE PASSWORD ---
BCDM_AUTH_USER=admin
BCDM_AUTH_PASSWORD=admin

# --- ntfy alerts (https://ntfy.sh or self-hosted) ---
BCDM_NTFY_SERVER=https://ntfy.sh
# pick a hard-to-guess topic and subscribe to it in the ntfy app
BCDM_NTFY_TOPIC=ntfy-alerts
# optional access token for protected topics
BCDM_NTFY_TOKEN=
BCDM_ALERT_NEW_DEVICE=true
